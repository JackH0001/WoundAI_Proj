<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  醫療版隱私宣告（App Store 自 2024-05 起強制）。

	  ⚠ 這份檔案必須與 App Store Connect 的「App 隱私權」問卷**答案一致**。
	  兩邊不一致時 Apple 以問卷為準，但不一致本身就會引來審查詢問。

	  ⚠ 本檔宣告的是「App 可能蒐集什麼」，不是「這次蒐集了什麼」。
	  醫療版的訓練標註受②訓練同意閘門控制（未同意就不上傳），但宣告仍須涵蓋
	  ——隱私宣告描述能力邊界，同意書描述實際發生。
	-->

	<!-- 不做跨 App 追蹤，也沒有任何追蹤網域。這是實話，也是我們的設計。 -->
	<key>NSPrivacyTracking</key>
	<false/>
	<key>NSPrivacyTrackingDomains</key>
	<array/>

	<key>NSPrivacyCollectedDataTypes</key>
	<array>
		<!--
		  傷口影像。**連結身分＝是**：不是因為影像本身含個資（去識別代碼
		  WD-xxxxxxxx 不指向病患），而是因為它與**登入的臨床帳號**綁定，
		  而 Apple 的定義是「與使用者帳號或裝置關聯」。誠實勾是的成本很低，
		  勾錯被查到的成本很高。
		-->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypePhotosorVideos</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeOther</string>
			</array>
		</dict>

		<!-- 傷口面積／組織比例／PUSH／滲液＝健康資料 -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeHealth</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
				<string>NSPrivacyCollectedDataTypePurposeOther</string>
			</array>
		</dict>

		<!-- 臨床帳號（由機構管理者開通，App 內不提供註冊） -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeUserID</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeAppFunctionality</string>
			</array>
		</dict>

		<!-- LiDAR 深度幾何與拍攝品質指標（供 3D 量測精度研究） -->
		<dict>
			<key>NSPrivacyCollectedDataType</key>
			<string>NSPrivacyCollectedDataTypeOtherDiagnosticData</string>
			<key>NSPrivacyCollectedDataTypeLinked</key>
			<true/>
			<key>NSPrivacyCollectedDataTypeTracking</key>
			<false/>
			<key>NSPrivacyCollectedDataTypePurposes</key>
			<array>
				<string>NSPrivacyCollectedDataTypePurposeOther</string>
			</array>
		</dict>
	</array>

	<key>NSPrivacyAccessedAPITypes</key>
	<array>
		<!--
		  UserDefaults：後端位址、帳號、加密後的密碼、待重試佇列
		  （`Core/AppSettings.swift`）。全部只供本 App 自己使用，
		  不外送、不做識別 → 理由碼 CA92.1。
		-->
		<dict>
			<key>NSPrivacyAccessedAPIType</key>
			<string>NSPrivacyAccessedAPICategoryUserDefaults</string>
			<key>NSPrivacyAccessedAPITypeReasons</key>
			<array>
				<string>CA92.1</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
