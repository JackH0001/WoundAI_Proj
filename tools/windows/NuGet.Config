<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <!-- Do not inherit a machine/user NuGet.Config.  On managed Windows hosts
       that file may be unreadable and dotnet otherwise silently has no source. -->
  <packageSources>
    <clear />
    <add key="nuget.org" value="https://api.nuget.org/v3/index.json" protocolVersion="3" />
  </packageSources>
</configuration>
